[Unit]
Description=Mukit Frontend Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mukit-py/frontend
Environment="PATH=/var/www/uludupec/data/.nvm/versions/node/v24.13.0/bin:/usr/bin:/usr/local/bin"
Environment="NODE_ENV=production"
# For port mode: INSTANCE_HOST=0.0.0.0 PORT=3333
# For socket mode: SOCKET=/var/run/mukit-frontend.sock
EnvironmentFile=/var/www/mukit-py/frontend/.env
ExecStart=/var/www/uludupec/data/.nvm/versions/node/v24.13.0/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mukit-frontend

[Install]
WantedBy=multi-user.target

